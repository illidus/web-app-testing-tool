# Environment Configuration Template - SoilOptix Customer Portal
# Copy this file to .env and fill in your actual credentials
# WARNING: Never commit the .env file with real credentials

# Base URL for the Customer Portal (staging environment)
BASE_URL=https://customerportalstaging.local.soiloptix.com

# Farm ID to use for testing
FARM_ID=20101

# Customer role credentials (for upload testing)
CUSTOMER_USER=ppiryane@gmail.com
CUSTOMER_PASS=b1isu2P0rtwr@ith

# Optional: Include sensitive datasets (default: false)
# INCLUDE_SENSITIVE=false

# Optional: Override parallel worker count (default: auto)
# PYTEST_WORKERS=4

# Optional: Enable headed browser for debugging (default: false)
# HEADED_BROWSER=false

# Optional: Slow down operations for debugging (milliseconds)
# SLOW_MO=0

# Optional: Override timeouts (milliseconds)
# FILE_UPLOAD_TIMEOUT=120000  # 2 minutes
# SUBMIT_ANALYSIS_TIMEOUT=300000  # 5 minutes
