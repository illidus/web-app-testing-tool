# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# WARNING: Never commit the .env file with real credentials

# Base URL for the application under test
BASE_URL=https://staging.internal

# Analyst role credentials
ANALYST_USER=svc_analyst
ANALYST_PASS=***REPLACE_WITH_ACTUAL_PASSWORD***

# Admin role credentials
ADMIN_USER=svc_admin
ADMIN_PASS=***REPLACE_WITH_ACTUAL_PASSWORD***

# Optional: Include sensitive datasets (default: false)
# INCLUDE_SENSITIVE=false

# Optional: Override parallel worker count (default: auto)
# PYTEST_WORKERS=4

# Optional: Override max wait time for preprocessing (milliseconds)
# MAX_PREPROCESSING_WAIT=120000

# Optional: Enable headed browser for debugging (default: false)
# HEADED_BROWSER=false

# Optional: Slow down operations for debugging (milliseconds)
# SLOW_MO=0
